{
  "name": "baba-selo-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI cooking companion for Balkan recipes and meal planning. Built with Next.js, LangChain/LangGraph, SpacetimeDB, and PostgreSQL/pgvector.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "local:setup": "node scripts/dev-local.mjs --setup-only",
    "docker:stop": "docker compose stop",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/local/backend.test.ts scripts/local/runtime.test.mjs",
    "test:local": "tsx --test scripts/local/backend.test.ts",
    "test:integration": "node scripts/local/test-integration.mjs",
    "build": "next build",
    "start": "node scripts/dev-local.mjs --production",
    "generate-style-previews": "node scripts/generate-style-previews.mjs",
    "generate-blog-images": "node scripts/generate-blog-images.mjs",
    "generate-blog-images-all": "node scripts/generate-blog-images.mjs --all",
    "create-blog-post": "node scripts/create-blog-post.mjs",
    "test:cache": "node scripts/test-recipe-cache.mjs",
    "sync:recipes": "node scripts/sync-recipes.mjs",
    "dev:clean": "node scripts/clean-next.mjs && node scripts/dev-local.mjs",
    "clean": "node scripts/clean-next.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-pgvector": "^0.0.14",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@11labs/react": "^0.0.4",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@langchain/pgvector": "^0.1.0",
    "@langchain/core": "^1.1.24",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/openai": "^1.2.8",
    "chart.js": "^4.4.7",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "next": "^15.0.7",
    "openai": "^7.45.1",
    "pg": "^8.18.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "resend": "^6.9.2",
    "sharp": "^0.35.5",
    "stripe": "^20.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "5.7.2"
  },
  "overrides": { "postcss": "$postcss", "sharp": "$sharp" }
}
