# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
.cursor/

*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# scraping and corpus data (never upload to GitHub)
scraping/

# vercel
.vercel

# Local editor and OS files
.vscode/
.idea/
Thumbs.db
*.zip

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Local databases, developer sessions, uploads, and generated module output
/.local/
/spacetimedb/node_modules/
/spacetimedb/dist/
!.env.example
