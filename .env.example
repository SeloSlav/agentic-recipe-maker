# Copy to .env.local. All databases and file storage run on your machine.

# Choose a provider; see docs/AI_PROVIDERS.md for every supported cloud/local API.
# Default: OpenAI. Other providers do not need an OpenAI key.
AI_PROVIDER=openai
OPENAI_API_KEY=
# For another cloud: set AI_PROVIDER, AI_MODEL, and AI_API_KEY (or its native key variable).
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
# Native Ollama, entirely local inference (pull these models first):
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# AI_BASE_URL=http://127.0.0.1:11434
# AI_EMBEDDING_PROVIDER=ollama
# AI_EMBEDDING_MODEL=nomic-embed-text
# Embeddings can use a different provider from chat, or be disabled.
# AI_EMBEDDING_PROVIDER=disabled
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=
# Optional per-task models (otherwise inherit AI_MODEL):
# AI_CHAT_MODEL=
# AI_RECIPE_MODEL=
# AI_ENRICHMENT_MODEL=
# AI_TRANSLATION_MODEL=
# AI_VISION_MODEL=
# Optional generated images/transcription still use OPENAI_API_KEY.

# Local defaults. Change these if a port is already in use.
LOCAL_APP_PORT=3001
LOCAL_POSTGRES_PORT=5433
LOCAL_SPACETIME_PORT=3100

# Set this to use a regular local PostgreSQL server instead of the default PGlite runtime:
# LOCAL_POSTGRES_URL=postgresql://baba:baba-local-only@127.0.0.1:5433/baba_selo
# For --external (you manage the SpacetimeDB process yourself):
# LOCAL_SPACETIMEDB_URL=http://127.0.0.1:3100
# LOCAL_SPACETIMEDB_DATABASE=baba-selo-local
